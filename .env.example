# Copy to .env and fill in. The CLI loads .env from the working directory.

# Credentials for the Anthropic API. Not needed if you've run `ant auth login`.
ANTHROPIC_API_KEY=

# Model used by every agent (default: claude-opus-5-5).
PATCHWORK_MODEL=claude-opus-5-5

# Reasoning effort: low | medium | high | xhigh | max (default: high).
PATCHWORK_EFFORT=high
